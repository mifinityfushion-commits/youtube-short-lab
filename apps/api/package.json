{
  "name": "@shortlab/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/apps/api/src/server.js",
    "prisma": "prisma",
    "pretypecheck": "prisma generate",
    "prelint": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/session": "^11.1.0",
    "@prisma/client": "^6.2.1",
    "@shortlab/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg-boss": "^10.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "@types/node": "^22.13.4"
  }
}
